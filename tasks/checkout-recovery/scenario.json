{
  "version": "sapi-lab-benchmark/v1",
  "id": "checkout-recovery",
  "default": false,
  "public": [
    "instruction.md",
    "authoring-notes.md",
    "bindings.yaml",
    "authoring-prompt.txt"
  ],
  "trusted": [
    "operations.js",
    "legacy-task.toml",
    "verifier.sh",
    "environment/__init__.py",
    "environment/hooks.py",
    "environment/server.py",
    "environment/install.py",
    "environment/legacy-compose.yaml",
    "environment/verifier.Dockerfile",
    "provenance/autowfbench-source.json",
    "evaluation/__init__.py",
    "evaluation/evaluator.py",
    "evaluation/scoring.py",
    "evaluation/calibration.py",
    "evaluation/judge-calibration.json"
  ],
  "reference": "solution/config.yaml",
  "bindings": "bindings.yaml",
  "operations": "operations.js",
  "harbor_task": "legacy-task.toml",
  "entrypoints": {
    "plan": {
      "path": "environment/hooks.py",
      "symbol": "plan"
    },
    "prepare": {
      "path": "environment/hooks.py",
      "symbol": "prepare"
    },
    "snapshot": {
      "path": "environment/hooks.py",
      "symbol": "snapshot"
    },
    "evaluate": {
      "path": "evaluation/evaluator.py",
      "symbol": "evaluate"
    }
  },
  "dependencies": {},
  "controls": {
    "oracle_acceptance": true,
    "reference_reward": 0.732
  },
  "budgets": {
    "authoring_attempts": 2,
    "runtime_model_calls": 4,
    "judge_calls": 1
  },
  "config": {
    "legacy": {
      "provenance": {
        "source": "autowfbench",
        "challenge": "production-checkout-recovery"
      },
      "environment": "autowfbench",
      "evaluator": "autowfbench",
      "default": false,
      "workflow_id": "checkout-workflow",
      "bindings": "bindings.yaml",
      "budgets": {
        "authoring_attempts": 2,
        "runtime_model_calls": 4
      },
      "output": {
        "artifact_field": "incident_summary",
        "artifact_name": "incident-summary.md"
      },
      "controls": {
        "reference_reward": 0.732
      }
    },
    "deadline_seconds": 120,
    "authoring": {
      "prompt": "authoring-prompt.txt",
      "catalogs": [
        "full"
      ]
    }
  }
}
