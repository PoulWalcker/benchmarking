{
  "version": "sapi-lab-benchmark/v1",
  "id": "beacon-calibration",
  "default": false,
  "public": [
    "instruction.md",
    "bindings.yaml"
  ],
  "trusted": [
    "operations.js",
    "verifier.sh",
    "environment/docker-compose.yaml",
    "environment/server.py",
    "environment/hooks.py",
    "evaluation/evaluator.py",
    "task.toml"
  ],
  "reference": "config.yaml",
  "bindings": "bindings.yaml",
  "operations": "operations.js",
  "harbor_task": "task.toml",
  "entrypoints": {
    "plan": {
      "path": "environment/hooks.py",
      "symbol": "plan"
    },
    "prepare": {
      "path": "environment/hooks.py",
      "symbol": "prepare"
    },
    "snapshot": {
      "path": "environment/hooks.py",
      "symbol": "snapshot"
    },
    "evaluate": {
      "path": "evaluation/evaluator.py",
      "symbol": "evaluate"
    }
  },
  "dependencies": {},
  "controls": {
    "oracle_acceptance": true,
    "reference_reward": null
  },
  "budgets": {
    "authoring_attempts": 0,
    "runtime_model_calls": 0,
    "judge_calls": 0
  },
  "config": {
    "deadline_seconds": 30
  }
}
