{
  "roles": {
    "classify": {
      "operation": "ticket.classify",
      "kind": "LLM",
      "inputs": {
        "ticket": {
          "ref": "inputs.ticket"
        }
      }
    },
    "escalate": {
      "operation": "ticket.escalation_draft",
      "kind": "Script",
      "inputs": {
        "ticket": {
          "ref": "inputs.ticket"
        }
      },
      "when": {
        "ref": "steps.classify.priority",
        "eq": "high"
      }
    },
    "normal": {
      "operation": "ticket.normal_draft",
      "kind": "Script",
      "inputs": {
        "ticket": {
          "ref": "inputs.ticket"
        }
      },
      "when": {
        "ref": "steps.classify.priority",
        "eq": "normal"
      }
    },
    "select": {
      "operation": "branch.select_one",
      "kind": "Script",
      "inputs": {
        "escalated": {
          "optional_ref": "steps.escalate"
        },
        "normal": {
          "optional_ref": "steps.normal"
        }
      }
    },
    "product": {
      "operation": "research.product",
      "kind": "LLM",
      "inputs": {
        "material": {
          "ref": "inputs.product_material"
        }
      },
      "when": {
        "ref": "steps.classify.priority",
        "eq": "high"
      }
    },
    "marketing": {
      "operation": "research.marketing",
      "kind": "LLM",
      "inputs": {
        "material": {
          "ref": "inputs.marketing_material"
        }
      },
      "when": {
        "ref": "steps.classify.priority",
        "eq": "high"
      }
    },
    "combine": {
      "operation": "research.combine",
      "kind": "Script",
      "inputs": {
        "product": {
          "optional_ref": "steps.product"
        },
        "marketing": {
          "optional_ref": "steps.marketing"
        }
      },
      "when": {
        "ref": "steps.classify.priority",
        "eq": "high"
      }
    },
    "write": {
      "operation": "research.write",
      "kind": "LLM",
      "inputs": {
        "brief": {
          "optional_ref": "steps.combine"
        }
      },
      "when": {
        "ref": "steps.classify.priority",
        "eq": "high"
      }
    }
  },
  "edges": [
    [
      "classify",
      "escalate"
    ],
    [
      "classify",
      "normal"
    ],
    [
      "escalate",
      "select"
    ],
    [
      "normal",
      "select"
    ],
    [
      "select",
      "product"
    ],
    [
      "select",
      "marketing"
    ],
    [
      "product",
      "combine"
    ],
    [
      "marketing",
      "combine"
    ],
    [
      "combine",
      "write"
    ]
  ],
  "output": {
    "action": {
      "ref": "steps.select"
    },
    "brief": {
      "optional_ref": "steps.write"
    }
  }
}
