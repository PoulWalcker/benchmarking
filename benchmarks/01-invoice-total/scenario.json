
{
  "version": "sapi-lab-benchmark/v1",
  "id": "invoice-total",
  "default": true,
  "public": [
    "instruction.md",
    "task.md",
    "bindings.yaml"
  ],
  "trusted": [
    "operations.js",
    "task.toml",
    "verifier.sh",
    "cases.json",
    "evaluation/__init__.py",
    "evaluation/contract.json",
    "evaluation/rubric.json",
    "evaluation/outputs.json",
    "evaluation/evaluator.py"
  ],
  "reference": "config.yaml",
  "bindings": "bindings.yaml",
  "operations": "operations.js",
  "harbor_task": "task.toml",
  "entrypoints": {
    "plan": {
      "path": "evaluation/evaluator.py",
      "symbol": "plan"
    },
    "evaluate": {
      "path": "evaluation/evaluator.py",
      "symbol": "evaluate"
    }
  },
  "dependencies": {},
  "controls": {
    "oracle_acceptance": true,
    "reference_reward": null
  },
  "budgets": {
    "authoring_attempts": null,
    "runtime_model_calls": null,
    "judge_calls": 0
  },
  "config": {
    "legacy": {
      "environment": "fixtures",
      "evaluator": "verifier",
      "harbor": {
        "verifier_timeout_sec": 6000
      }
    },
    "deadline_seconds": 30,
    "cases": "cases.json",
    "authoring": {
      "catalogs": [
        "full",
        "scenario"
      ]
    }
  }
}
