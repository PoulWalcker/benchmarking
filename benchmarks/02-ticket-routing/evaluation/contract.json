{
  "roles": {
    "classify": {
      "operation": "ticket.classify",
      "kind": "LLM",
      "inputs": {
        "ticket": {
          "ref": "inputs.ticket"
        }
      }
    },
    "escalate": {
      "operation": "ticket.escalation_draft",
      "kind": "Script",
      "inputs": {
        "ticket": {
          "ref": "inputs.ticket"
        }
      },
      "when": {
        "ref": "steps.classify.priority",
        "eq": "high"
      }
    },
    "normal": {
      "operation": "ticket.normal_draft",
      "kind": "Script",
      "inputs": {
        "ticket": {
          "ref": "inputs.ticket"
        }
      },
      "when": {
        "ref": "steps.classify.priority",
        "eq": "normal"
      }
    },
    "select": {
      "operation": "branch.select_one",
      "kind": "Script",
      "inputs": {
        "escalated": {
          "optional_ref": "steps.escalate"
        },
        "normal": {
          "optional_ref": "steps.normal"
        }
      }
    }
  },
  "edges": [
    [
      "classify",
      "escalate"
    ],
    [
      "classify",
      "normal"
    ],
    [
      "escalate",
      "select"
    ],
    [
      "normal",
      "select"
    ]
  ],
  "output": {
    "ref": "steps.select"
  }
}
