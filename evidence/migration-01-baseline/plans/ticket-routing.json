        "schema": "sapi-lab/v0",
        "spec_revision": "06ddd3333109cea8a2cb3071609070d7a3c0d3ff",
        "workflow": {
          "acceptance": "Exactly one action draft; high priority routes to escalation.",
          "dependencies": [
            [
              "classify",
              "escalate"
            ],
            [
              "classify",
              "normal"
            ],
            [
              "escalate",
              "result"
            ],
            [
              "normal",
              "result"
            ]
          ],
          "id": "ticket-routing",
          "inputs": {
            "ticket": {
              "days_overdue": 3,
              "id": "T-17",
              "text": "Order A7842 is three days late. Please help."
            }
          },
          "kind": "Gantt",
          "output": {
            "ref": "steps.result"
          },
          "revision": 1,
          "steps": [
            {
              "id": "classify",
              "kind": "LLM",
              "uses": "ticket.classify",
              "with": {
                "ticket": {
                  "ref": "inputs.ticket"
                }
              }
            },
            {
              "id": "escalate",
              "kind": "Script",
              "uses": "ticket.escalation_draft",
              "when": {
                "eq": "high",
                "ref": "steps.classify.priority"
              },
              "with": {
                "ticket": {
                  "ref": "inputs.ticket"
                }
              }
            },
            {
              "id": "normal",
              "kind": "Script",
              "uses": "ticket.normal_draft",
              "when": {
                "eq": "normal",
                "ref": "steps.classify.priority"
              },
              "with": {
                "ticket": {
                  "ref": "inputs.ticket"
                }
              }
            },
            {
              "id": "result",
              "join": "all_terminal",
              "kind": "Script",
              "uses": "branch.select_one",
              "with": {
                "escalated": {
                  "optional_ref": "steps.escalate"
                },
                "normal": {
                  "optional_ref": "steps.normal"
                }
              }
            }
          ]
        }
      },
      "kind": "positive",
      "name": "high-three-days",
      "procedure": "case"
